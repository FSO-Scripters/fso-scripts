; ship save/load script by Admiral MS, rewritten by Goober5000
; script uses "," "&" ":" and "§" for data separation. weapon and subsystem data should not contain any of these or the script fails
; see readme for instructions how to use this script

#Conditional Hooks

$Application: FS2_Open
$On Game Init:
[
	ShipSave = {}
	ShipSave.save_file_exists_cache = {}

	--definitions for savefile
	ShipSave.path_shipsave = "data/scripts/"

	--FSO 26.0 deprecated the old status enum names, which raise an error in a mod targeting 26.0 or later
	ShipSave.status_not_yet_present = SHIP_STATUS_NOT_YET_PRESENT or NOT_YET_PRESENT

	--name of a handle, or an empty string if the handle is nil or invalid
	local function NameIfValid(obj)
		if obj and obj:isValid() then
			return obj.Name
		end
		return ""
	end

	-- ================================================== --
	-- sexp functions (public API)
	-- ================================================== --

	function ShipSave:save_init(filename)
		if filename then
			self.active_filename = filename
		end
		self:clear()
	end
	mn.LuaSEXPs["lua-save-init"].Action = function(filename)
		ShipSave:save_init(filename)
	end

	function ShipSave:save_ship(shipname)
		if shipname then
			self.shipsaveload_data.ships[shipname] = self:write_ship_string(shipname)
		end
	end
	mn.LuaSEXPs["lua-save-ship"].Action = function(...)
		for i,v in ipairs(arg) do
			ShipSave:save_ship(v[1])
		end
	end

	function ShipSave:save_variable(varname)
		if varname then
			self.shipsaveload_data.variables[varname] = self:write_variable_string(varname)
		end
	end
	mn.LuaSEXPs["lua-save-variable"].Action = function(...)
		for i,v in ipairs(arg) do
			ShipSave:save_variable(v[1].Name)
		end
	end

	function ShipSave:save_done()
		self:saveshipfile()
	end
	mn.LuaSEXPs["lua-save-done"].Action = function()
		ShipSave:save_done()
	end

	function ShipSave:load_init(filename)
		if filename then
			self.active_filename = filename
		end
		self:loadshipfile()
	end
	mn.LuaSEXPs["lua-load-init"].Action = function(filename)
		ShipSave:load_init(filename)
	end

	function ShipSave:load_ship(shipname, loadtype)
		if shipname then
			local shipstring = self.shipsaveload_data.ships[shipname]
			if not shipstring then
				ba.print("SaveLoad: no save data for ship '" .. shipname .. "', nothing to load\n")
				return
			end
			self:read_ship_from_string(shipname, shipstring, loadtype)
		end
	end
	mn.LuaSEXPs["lua-load-ship"].Action = function(loadtype, ...)
		for i,v in ipairs(arg) do
			ShipSave:load_ship(v[1], loadtype)
		end
	end

	function ShipSave:make_ship_arrive(shipname)
		if shipname then
			local entry = mn.ShipRegistry[shipname]
			if entry and entry.Status == self.status_not_yet_present then
				local parsed = entry:getParsedShip()
				if parsed and parsed:isValid() then	-- if it's not valid, it's the support ship
					local wing = parsed:getWing()
					if wing and wing:isValid() then
						if wing.TotalArrived == 0 then
							wing.ArrivalLocation = "Hyperspace"
							wing:setFlag(true, "no-arrival-warp", "no-arrival-music", "no-arrival-message")
							wing:makeWingArrive()
						end
					else
						parsed.ArrivalLocation = "Hyperspace"
						parsed:setFlag(true, "no-arrival-warp", "no-arrival-music")
						parsed:makeShipArrive()
					end
				end
			end
		end
	end
	mn.LuaSEXPs["lua-spawn-and-load-ship"].Action = function(loadtype, ...)
		for i,v in ipairs(arg) do
			ShipSave:make_ship_arrive(v[1])
			ShipSave:load_ship(v[1], loadtype)
		end
	end

	function ShipSave:load_variable(varname)
		if varname then
			self:read_variable_from_string(varname, self.shipsaveload_data.variables[varname])
		end
	end
	mn.LuaSEXPs["lua-load-variable"].Action = function(...)
		for i,v in ipairs(arg) do
			ShipSave:load_variable(v[1].Name)
		end
	end

	function ShipSave:copy_ship(shipname1, shipname2, loadtype)
		if shipname1 and shipname2 then
			local str = self:write_ship_string(shipname1)
			self:read_ship_from_string(shipname2, str, loadtype)

			local ship = mn.Ships[shipname1]
			if ship and ship:isValid() then
				local target = mn.Ships[shipname2]
				if target and target:isValid() then
					target.Physics = ship.Physics
				end
			end
		end
	end
	mn.LuaSEXPs["lua-copy-ship"].Action = function(loadtype, shipname1, ...)
		for i,v in ipairs(arg) do
			ShipSave:copy_ship(shipname1, v[1], loadtype)
		end
	end

	--checks if there is a savefile, is called in fred
	function ShipSave:saveexist(filename)
		if filename then
			self.active_filename = filename
		end
		local result = self.save_file_exists_cache[self.active_filename]
		if result == nil then
			-- cache the result so we don't need to keep querying the file system
			-- (the cache is cleared on each mission start)
			result = cf.fileExists(self.active_filename,self.path_shipsave,true)
			self.save_file_exists_cache[self.active_filename] = result
		end
		return result
	end
	mn.LuaSEXPs["lua-save-file-exists"].Action = function(filename)
		return ShipSave:saveexist(filename)
	end

	--deletes savefile, is called in fred
	function ShipSave:deleteshipsavefile(filename)
		if filename then
			self.active_filename = filename
		end
		if (cf.fileExists(self.active_filename,self.path_shipsave,true)) then
			cf.deleteFile(self.active_filename,self.path_shipsave)
		end
		-- recheck on the next query: the delete may have failed, or a copy may exist in a VP
		self.save_file_exists_cache[self.active_filename] = nil
	end
	mn.LuaSEXPs["lua-delete-save-file"].Action = function(filename)
		ShipSave:deleteshipsavefile(filename)
	end

	-- ================================================== --
	-- internal functions, not called by sexp
	-- ================================================== --

	function ShipSave:clear()
		self.shipsaveload_data = {}
		self.shipsaveload_data.ships = {}
		self.shipsaveload_data.variables = {}
	end

	--stores data into the savefile
	function ShipSave:saveshipfile()
		local file = cf.openFile(self.active_filename,"w",self.path_shipsave)
		if not file or not file:isValid() then
			ba.print("SaveLoad: could not open file '" .. self.active_filename .. "' for writing!\n")
			return
		end
		file:write("§")

		-- write variables
		local wrote_first = false
		for k,v in pairs(self.shipsaveload_data.variables) do
			if wrote_first then
				file:write("&")
			else
				wrote_first = true
			end
			file:write(v)
		end
		file:write("\n")

		-- write ship names
		wrote_first = false
		for k,v in pairs(self.shipsaveload_data.ships) do
			if wrote_first then
				file:write(",")
			else
				wrote_first = true
			end
			file:write(k)
		end
		file:write("\n")

		-- write ship info
		for k,v in pairs(self.shipsaveload_data.ships) do
			file:write(v .. "\n")
		end

		file:close()
		self.save_file_exists_cache[self.active_filename] = true
	end

	--loads savefile and splits the lists
	function ShipSave:loadshipfile()
		self:clear()
		if not cf.fileExists(self.active_filename,self.path_shipsave,true) then
			ba.print("SaveLoad: file " .. self.active_filename .. " does not exist!\n")
			return
		end
		local file = cf.openFile(self.active_filename,"r",self.path_shipsave)
		if not file or not file:isValid() then
			ba.print("SaveLoad: could not open file '" .. self.active_filename .. "' for reading!\n")
			return
		end

		-- get the variables
		local varline = file:read("*l")
		if varline and string.find(varline, "§") == 1 then
			local tempb = self:split(varline, "§")
			if tempb[2] and tempb[2] ~= "" then
				local varstrings = self:split(tempb[2], "&")
				for i=1,#varstrings do
					local vardata = self:split(varstrings[i], ",")
					if #vardata ~= 3 then
						ba.print("SaveLoad: could not split " .. varstrings[i] .. " into three tokens\n")
					else
						self.shipsaveload_data.variables[vardata[1]] = varstrings[i]
					end
				end
			end
		else
			ba.print("SaveLoad: could not read variables; improperly formatted file!\n")
		end

		-- get the ships
		local shipline = file:read("*l")
		if shipline and shipline ~= "" then
			local ships = self:split(shipline, ",")
			for i=1,#ships do
				local shipline = file:read("*l")
				if shipline and shipline ~= "" then
					self.shipsaveload_data.ships[ships[i]] = shipline
				else
					ba.print("SaveLoad: could not read ships; improperly formatted file!\n")
					break
				end
			end
		end

		file:close()
	end

	function ShipSave:write_variable_string(varname)
		if not varname then
			return nil
		end
		local var = mn.SEXPVariables[varname]
		if not var or not var:isValid() then
			return nil
		end
		local str
		if var.Type == SEXPVAR_TYPE_NUMBER then
			str = varname .. ",n," .. tostring(var.Value)
		else
			str = varname .. ",s," .. var.Value
		end
		return str
	end

	-- tries to set a variable
	function ShipSave:read_variable_from_string(varname, str)
		if not varname or not str then
			return
		end
		local var = mn.SEXPVariables[varname]
		if not var or not var:isValid() then
			ba.print("SaveLoad: target variable '"..varname.."' not found\n")
			return
		end
		local arr = self:split(str, ",")
		if #arr ~= 3 then
			ba.print("SaveLoad: could not split '" .. str .. "' into three tokens; skipping variable '" .. varname .. "'\n")
			return
		end
		if var.Type == SEXPVAR_TYPE_NUMBER then
			if arr[2] ~= "n" then
				ba.print("SaveLoad: variable type mismatch; source is string but target is numeric\n")
				return
			end
			local num = tonumber(arr[3])
			if num == nil then
				ba.print("SaveLoad: value '" .. arr[3] .. "' for numeric variable '" .. varname .. "' is not a number; skipping\n")
				return
			end
			var.Value = num
		else
			if arr[2] ~= "s" then
				ba.print("SaveLoad: variable type mismatch; source is numeric but target is string\n")
				return
			end
			var.Value = arr[3]
		end
	end

	function ShipSave:write_ship_string(shipname)
		if not shipname then
			return nil
		end
		return self:shipdatacollect(shipname)
	end

	function ShipSave:read_ship_from_string(shipname, str, loadtype)
		if not shipname or not str or not loadtype then
			return
		end
		self:shipdataset(shipname, str, loadtype)
	end

	--splits strings
	function ShipSave:split(str, sep, maxNb)
		-- Eliminate bad cases...
		if string.find(str, sep) == nil then
			return { str }
		end
		if maxNb == nil or maxNb < 1 then
			maxNb = 0    -- No limit
		end
		local result = {}
		local pat = "(.-)" .. sep .. "()"
		local nb = 0
		local lastPos
		for part, pos in string.gmatch(str, pat) do
			nb = nb + 1
			result[nb] = part
			lastPos = pos
			if nb == maxNb then break end
		end
		-- Handle the last field
		if nb ~= maxNb then
			result[nb + 1] = string.sub(str, lastPos)
		end
		return result
	end

	--parses a numeric field from the save file, logging and returning nil if it is not a number
	function ShipSave:parsenumber(str, what)
		local num = tonumber(str)
		if num == nil then
			ba.print("SaveLoad: " .. what .. " '" .. tostring(str) .. "' is not a number\n")
		end
		return num
	end

	--looks up a saved name in a game table, logging and returning nil if it no longer exists.
	--a failed lookup yields an invalid handle, or nil under the nil-handles game setting
	function ShipSave:lookupname(gametable, name, shipname, what, keeping)
		local handle = gametable[name]
		if handle and handle:isValid() then
			return handle
		end
		ba.print("SaveLoad: " .. tostring(shipname) .. ": saved " .. what .. " '" .. tostring(name) .. "' not found, keeping " .. keeping .. "\n")
		return nil
	end

	function ShipSave:booltonum(val)
		if val then
			return 1
		else
			return 0
		end
	end

	function ShipSave:numtobool(val)
		return val and (val ~= 0)
	end

	function ShipSave:shipdatacollect(shipname)		--shipdata collector function including string creation; returns nil if the ship is unknown
		-- an unknown name must not reach the SEXP parser below
		local entry = mn.ShipRegistry[shipname]
		if not entry or not entry:isValid() then
			ba.print("SaveLoad: ship '" .. tostring(shipname) .. "' is not in this mission, not saving\n")
			return nil
		end

		-- a ship that has not arrived still has its mission-file attributes, so there is nothing to save
		if entry.Status == self.status_not_yet_present then
			ba.print("SaveLoad: ship '" .. shipname .. "' has not arrived yet, not saving\n")
			return nil
		end

		local ship = entry:getShip()		--ship handle; invalid if the ship has already left
		local shipdata = {}

		if (ship and ship:isValid() and (ship:hasShipExploded() == 0)) then		--ship existent and not exploding
			local basicdata = {}
			basicdata[1] = 1
			basicdata[2] = ship.Class.Name		--ship class
			basicdata[3] = ship.Team.Name			--team
			basicdata[4] = ship.HitpointsMax		--user defined max hp
			basicdata[5] = ship.HitpointsLeft		--hp left
			local cmeasure = ship.CountermeasureClass
			if (cmeasure and cmeasure:isValid()) then
				basicdata[6] = ship.CountermeasuresLeft
			else
				basicdata[6] = -1
			end
			if (ship.AfterburnerFuelMax > 0) then
				basicdata[7] = ship.AfterburnerFuelLeft
			else
				basicdata[7] = -1
			end
			if (ship.WeaponEnergyMax > 0) then
				basicdata[8] = ship.WeaponEnergyLeft
			else
				basicdata[8] = -1
			end
			local shields = ship.Shields
			if (shields and shields:isValid()) then		--shield data in case there is a shield, otherwise -1
				basicdata[9] = shields.CombinedMax
				basicdata[10] = shields[1]
				basicdata[11] = shields[2]
				basicdata[12] = shields[3]
				basicdata[13] = shields[4]
			else
				basicdata[9] = -1
				basicdata[10] = -1
				basicdata[11] = -1
				basicdata[12] = -1
				basicdata[13] = -1
			end
			shipdata[1] = basicdata

			local ns = #ship		--# subsystems
			local arr_subsys = {}
			if (ns > 0) then
				arr_subsys[1] = ns
				for i=1,ns do
					arr_subsys[2*i] = ship[i].HitpointsLeft				--hp subsystem
					arr_subsys[2*i+1] = self:weaponsdatacollect(ship[i],2)	--for turrets, only primaries und secondaries
				end
			else
				arr_subsys[1] = -1		--no subsystems
			end
			shipdata[2] = arr_subsys

			shipdata[3] = self:weaponsdatacollect(ship,1)		--normal weapons, primaries, secondaries, tertiaries

			local coords = {}
			for i=1,3 do
				coords[i] = ship.Position[i]
			end
			for i=1,9 do
				coords[i+3] = ship.Orientation[i]
			end
			for i=1,3 do
				coords[i+12] = ship.Physics.Velocity[i]
			end
			for i=1,3 do
				coords[i+15] = ship.Physics.RotationalVelocity[i]
			end
			shipdata[4] = coords
		else
			shipdata[1] = {}
			-- the registry's EXITED status does not distinguish destroyed from departed
			if (mn.evaluateSEXP("(is-destroyed-delay 0 !"..shipname.."!)")) then
				shipdata[1][1] = -2		--ship destroyed
			elseif (mn.evaluateSEXP("(has-departed-delay 0 !"..shipname.."!)")) then
				shipdata[1][1] = -1		--ship departed
			else
				shipdata[1][1] = -3		--ship-vanish used or something like it
			end
		end
		return self:createshipstring(shipdata)
	end

	function ShipSave:shipdataset(shipname, shipstring, loadtype)
		local ship = mn.Ships[shipname]		--ship handle
		if not ship or not ship:isValid() then
			-- nothing to do
			return
		end

		local shipdata = self:shipstringsplitter(shipstring)		-- create shipdata array and fill it
		if shipdata == nil then
			ba.print("SaveLoad: skipping " .. shipname .. ", malformed save data\n")
			return
		end
		local basicdata = shipdata[1]
		local shipstatus = basicdata[1]

		-- ship was ingame or wasn't arriving while saving
		if shipstatus == 1 then
			-- maybe change the ship class
			local newclassname = basicdata[2]
			local class_matches = (ship.Class.Name == newclassname)
			if not class_matches then
				local newclass = self:lookupname(tb.ShipClasses, newclassname, shipname, "ship class", "current class")
				if newclass then
					-- class lookup is case-insensitive, so compare with the class's own name
					if ship.Class.Name == newclass.Name then
						class_matches = true
					else
						mn.evaluateSEXP("(change-ship-class !"..newclassname.."! !"..shipname.."!)")
						class_matches = (ship.Class.Name == newclass.Name)
						if not class_matches then
							ba.print("SaveLoad: " .. shipname .. ": could not change class to '" .. newclass.Name .. "'\n")
						end
					end
				end
			end

			-- maybe change the ship team
			local newteamname = basicdata[3]
			if (ship.Team.Name ~= newteamname) then
				local newteam = self:lookupname(mn.Teams, newteamname, shipname, "team", "current team")
				if newteam then
					mn.evaluateSEXP("(change-iff !"..newteamname.."! !"..shipname.."!)")
				end
			end

			ship.HitpointsMax = basicdata[4]
			ship.HitpointsLeft = basicdata[5]
			if (basicdata[6] > -1) then
				ship.CountermeasuresLeft = basicdata[6]
			end

			-- type = 2
			-- loads additionally to type = 1: weapon energy, afterburner energy, shield energy
			if loadtype > 1 then
				if (ship.AfterburnerFuelMax > 0) then
					ship.AfterburnerFuelLeft = basicdata[7]
				end
				if (ship.WeaponEnergyMax > 0) then
					ship.WeaponEnergyLeft = basicdata[8]
				end

				local shields = ship.Shields
				if (shields and shields:isValid() and (basicdata[9] > 0)) then		--ship has shields and save contains shields
					shields.CombinedMax = basicdata[9]
					shields[1] = basicdata[10]
					shields[2] = basicdata[11]
					shields[3] = basicdata[12]
					shields[4] = basicdata[13]
				end
			end

			-- subsystems and weapon banks are stored by position within the saved class, so they only fit that class
			if not class_matches then
				ba.print("SaveLoad: " .. shipname .. ": class does not match the save, skipping subsystem and weapon data\n")
			else
				local arr_subsys = shipdata[2]
				local n_subsystems = arr_subsys[1]
				if (n_subsystems > 0) then		--ship has subsystems?
					local n_current = #ship
					if n_subsystems ~= n_current then
						ba.print("SaveLoad: " .. shipname .. ": saved subsystem count " .. n_subsystems .. " does not match current count " .. n_current .. ", applying what matches\n")
					end
					for i=1,math.min(n_subsystems, n_current) do
						local subsys = ship[i]
						if subsys and subsys:isValid() then
							if subsys.HitpointsMax > 0 then
								local hitpoints = arr_subsys[2*i]
								if hitpoints > 0 then
									subsys.HitpointsLeft = hitpoints
								else
									mn.evaluateSEXP("(destroy-subsys-instantly !"..shipname.."! !"..subsys:getModelName().."!)")
								end
							end
							self:weaponsinsert(arr_subsys[2*i+1], subsys, 2, shipname)	--turrets loader, only primaries and secondaries
						end
					end
				end

				self:weaponsinsert(shipdata[3], ship, 1, shipname)		--ships weapons, primaries, secondaries and tertiaries
			end

			-- type = 3
			-- loads additionally to type = 2: position and orientation
			if loadtype > 2 then
				local coords = shipdata[4]
				ship.Position = ba.createVector(coords[1],coords[2],coords[3])
				ship.Orientation = ba.createOrientation(coords[4],coords[5],coords[6],coords[7],coords[8],coords[9],coords[10],coords[11],coords[12])
			end

		-- recreate departed status
		elseif shipstatus == -1 then
			mn.evaluateSEXP("(set-departure-info !"..shipname.."! !Hyperspace! !<no anchor>! 0 0 (false))")
			ship:warpOut()

		-- recreate destroyed status
		elseif shipstatus == -2 then
			mn.evaluateSEXP("(destroy-instantly !"..shipname.."!)")

		-- recreate vanished status
		elseif shipstatus == -3 then
			mn.evaluateSEXP("(ship-vanish !"..shipname.."!)")

		else
			ba.print("SaveLoad: " .. shipname .. ": unknown status " .. tostring(shipstatus) .. " in save data, skipping\n")

		end
	end

	function ShipSave:weaponsdatacollect(object,which_wep)		--weapondata to array
		local array = {}
		local bank = object.PrimaryBanks		--handle primaries
		array[1] = self:weaponbankdatacollect(bank)
		bank = object.SecondaryBanks		--handle secondaries
		array[2] = self:weaponbankdatacollect(bank)
		if (which_wep == 1) then		-- 1=main weapons, 2=turrets
			bank = object.TertiaryBanks
			array[3] = self:weaponbankdatacollect(bank)
		else
			array[3] ={}
			array[3][1] = -2
		end
		return array
	end

	function ShipSave:weaponbankdatacollect(bank)		--weaponbankdata to array
		local array = {}
		if (bank and bank:isValid()) then
			local n = #bank		--number of weapons in bank
			if (n > 0) then
				array[1] = n
				array[2] = self:booltonum(bank.Linked)		--linked
				array[3] = self:booltonum(bank.DualFire)		--dual fire
				for j=1,n do
					local wbank=bank[j] 	--weaponbank handle
					local weapon = {}
					weapon[1] = NameIfValid(wbank.WeaponClass)		--weapon class name, empty if the bank is empty
					weapon[2] = self:booltonum(wbank.Armed)		--weapon active
					weapon[3] = wbank.AmmoMax
					if (weapon[3] > 0) then
						weapon[4] = wbank.AmmoLeft
					else
						weapon[4] = -1
					end
					array[3+j] = weapon
				end
			else
				array[1]=-1		--no weapons in bank
			end
		else
			array[1]=-2		--invalid bank, should not happen
		end
		return array
	end

	function ShipSave:weaponsinsert(array,object,which_wep,shipname)		--transfers weapondata from array to object
		if (array[1][1] > 0) then
			self:weaponbankinsert(object.PrimaryBanks,array[1],shipname)		--handle primaries
		end
		if (array[2][1] > 0) then
			self:weaponbankinsert(object.SecondaryBanks,array[2],shipname)		--handle secondaries
		end
		if ((which_wep == 1) and (array[3][1] > 0)) then		--1=main weapons, 2=turrets
			self:weaponbankinsert(object.TertiaryBanks,array[3],shipname)
		end
	end

	--writes the saved ammunition into a bank, which must already hold the saved weapon class
	function ShipSave:setbankammo(wbank,weapon)
		local wclass = wbank.WeaponClass
		if not wclass or not wclass:isValid() then
			return
		end
		-- NOTE: see the documentation on the AmmoMax virtvar in the FSO code.  Setting what you get is not idempotent.
		wbank.AmmoMax = weapon[3] * wclass.CargoSize
		if (weapon[3] > 0) then
			wbank.AmmoLeft = weapon[4]
		end
	end

	function ShipSave:weaponbankinsert(bank,array,shipname)		--array to weaponbankdata
		if not bank or not bank:isValid() then
			return
		end
		bank.Linked = self:numtobool(array[2])		--linked
		bank.DualFire = self:numtobool(array[3])		--dual fire
		local n = array[1]
		local n_current = #bank
		if n ~= n_current then
			ba.print("SaveLoad: " .. tostring(shipname) .. ": saved weapon count " .. n .. " does not match current bank size " .. n_current .. ", applying what matches\n")
		end
		for j=1,math.min(n, n_current) do
			local wbank=bank[j] 	--weaponbank handle
			local weapon = array[3+j]
			if wbank and wbank:isValid() then
				local currentname = NameIfValid(wbank.WeaponClass)

				if weapon[1] == "" then
					-- the slot was empty when saved, and the scripting API cannot empty a bank

				elseif (currentname == weapon[1]) then		--prevent it from doing unnecessary stuff
					self:setbankammo(wbank,weapon)

				else
					local keeping = "the empty bank"
					if currentname ~= "" then
						keeping = "'" .. currentname .. "'"
					end
					local wclass = self:lookupname(tb.WeaponClasses, weapon[1], shipname, "weapon class", keeping)
					if wclass then
						wbank.WeaponClass = wclass		--weapon class
						self:setbankammo(wbank,weapon)
					end
					-- otherwise the saved ammunition belongs to a different weapon
				end

				local b_armed = self:numtobool(weapon[2])
				if b_armed then
					wbank.Armed = b_armed						--weapon active
				end
			end
		end
	end

	function ShipSave:createshipstring(shipdata)		--shipstring creation for savefile
		local savestring = (shipdata[1][1]..",")
		local addstring
		if (shipdata[1][1] == 1) then
			savestring = (savestring..table.concat(shipdata[1],",",2,13)..",")		--basic data
			savestring = (savestring..":")

			local arr_subsys = shipdata[2]
			local n_subsystems = arr_subsys[1]
			savestring = (savestring..n_subsystems.."&")		--number of subsystems
			if (n_subsystems > 0) then
				for i=1,n_subsystems do		--subsystems and turret data
					savestring = (savestring..arr_subsys[2*i].."§")
					addstring = self:createweaponstring(arr_subsys[2*i+1])
					savestring = (savestring..addstring.."&")
				end
			end

			savestring = (savestring..":")
			addstring = self:createweaponstring(shipdata[3])		--weapons
			savestring = (savestring..addstring..":")
			savestring = (savestring..table.concat(shipdata[4],",",1,18))		--position and orientation
		else
			savestring = (savestring..":::")
		end
		return savestring
	end

	function ShipSave:createweaponstring(array)		--weaponstring creation for savefile
		local savestring = ""		--returns an empty string in any case
		for j=1,3 do
			local weaponbank = array[j]
			local n = weaponbank[1]
			if (n > 0) then
				savestring = (savestring..n..","..weaponbank[2]..","..weaponbank[3]..",")		--number, linked, dualfire
				for k=1,n do
					local weapon = weaponbank[3+k]
					savestring = (savestring..weapon[1]..","..weapon[2]..","..weapon[3]..",")		--weaponclass, ammomax, ammoleft
					savestring = (savestring..weapon[4])
					if (j ~= 3) then		--splitter wont like me without this
						savestring = (savestring..",")
					end
				end
			else
				savestring = (savestring..n)
				if (j ~= 3) then		--splitter wont like me without this
					savestring = (savestring..",")
				end
			end
		end
		return savestring
	end

	function ShipSave:shipstringsplitter(shipstring)		--splits shipstring into shipdata array; returns nil if the string is malformed
		if type(shipstring) ~= "string" or shipstring == "" then
			ba.print("SaveLoad: ship data is empty\n")
			return nil
		end
		local shipdata = {}

		local temp = self:split(shipstring,":")
		shipdata[1] = self:split(temp[1],",")
		shipdata[1][1] = self:parsenumber(shipdata[1][1], "ship status code")
		if shipdata[1][1] == nil then
			return nil
		end
		if (shipdata[1][1] == 1) then
			if #temp < 4 then
				ba.print("SaveLoad: ship data has " .. #temp .. " sections, expected 4\n")
				return nil
			end
			if #shipdata[1] < 13 then
				ba.print("SaveLoad: ship basic data has " .. #shipdata[1] .. " fields, expected at least 13\n")
				return nil
			end
			for m=4,13 do
				shipdata[1][m] = self:parsenumber(shipdata[1][m], "ship basic data field " .. m)
				if shipdata[1][m] == nil then
					return nil
				end
			end

			shipdata[2] = {}
			local subtemp = self:split(temp[2],"&")
			local n_subsystems = self:parsenumber(subtemp[1], "subsystem count")
			if n_subsystems == nil then
				return nil
			end
			shipdata[2][1] = n_subsystems
			if (n_subsystems > 0) then
				for i=1,n_subsystems do
					if subtemp[i+1] == nil then
						ba.print("SaveLoad: subsystem data lists " .. n_subsystems .. " subsystems but only " .. (i-1) .. " are present\n")
						return nil
					end
					local subtempint = self:split(subtemp[i+1],"§")
					if subtempint[2] == nil then
						ba.print("SaveLoad: subsystem " .. i .. " data '" .. subtemp[i+1] .. "' is malformed\n")
						return nil
					end
					local hitpoints = self:parsenumber(subtempint[1], "subsystem " .. i .. " hitpoints")
					if hitpoints == nil then
						return nil
					end
					shipdata[2][2*i] = hitpoints
					shipdata[2][2*i+1] = self:weaponstringsplitter(subtempint[2])
					if shipdata[2][2*i+1] == nil then
						return nil
					end
				end
			end

			shipdata[3] = self:weaponstringsplitter(temp[3])
			if shipdata[3] == nil then
				return nil
			end

			-- createshipstring writes 18 fields here but only the first 12 are used on load
			shipdata[4] = self:split(temp[4],",")
			if #shipdata[4] < 12 then
				ba.print("SaveLoad: position data has " .. #shipdata[4] .. " fields, expected at least 12\n")
				return nil
			end
			for m=1,12 do
				shipdata[4][m] = self:parsenumber(shipdata[4][m], "position data field " .. m)
				if shipdata[4][m] == nil then
					return nil
				end
			end
		end
		return shipdata
	end

	function ShipSave:weaponstringsplitter(subtempint)		--splits weapondata into array; returns nil if the string is malformed
		if type(subtempint) ~= "string" then
			ba.print("SaveLoad: weapon data is missing\n")
			return nil
		end
		local array = {}
		local pos = 1

		local temp = self:split(subtempint,",")
		for j=1,3 do
			local weaponbank = {}
			local n = self:parsenumber(temp[pos], "weapon bank " .. j .. " count")
			if n == nil then
				return nil
			end
			weaponbank[1] = n								--number
			if (n > 0) then
				weaponbank[2] = self:parsenumber(temp[pos+1], "weapon bank " .. j .. " linked flag")		--linked
				weaponbank[3] = self:parsenumber(temp[pos+2], "weapon bank " .. j .. " dual-fire flag")	--dualfire
				if weaponbank[2] == nil or weaponbank[3] == nil then
					return nil
				end
				pos = pos + 3
				for k=1,n do
					local weapon = {}
					-- an empty class name means the bank slot was empty
					weapon[1] = temp[pos]					--weapon class name
					weapon[2] = self:parsenumber(temp[pos+1], "weapon " .. k .. " in bank " .. j .. " armed flag")
					weapon[3] = self:parsenumber(temp[pos+2], "weapon " .. k .. " in bank " .. j .. " max ammo")
					weapon[4] = self:parsenumber(temp[pos+3], "weapon " .. k .. " in bank " .. j .. " ammo remaining")
					if weapon[1] == nil or weapon[2] == nil or weapon[3] == nil or weapon[4] == nil then
						ba.print("SaveLoad: weapon " .. k .. " in bank " .. j .. " is malformed\n")
						return nil
					end
					weaponbank[k+3] = weapon
					pos = pos + 4
				end
			else
				pos = pos + 1
			end
			array[j] = weaponbank
		end
		return array
	end
]

$On Mission Start:
[
	ShipSave.save_file_exists_cache = {}
	ShipSave:save_init(mn.getMissionFilename())
]

#End
