#Conditional Hooks
$Application: FS2_Open

$On Game Init:
[

axemParse = require "axParse"
if not axemParse then ba.error("axemParse not found, ensure AxBase is in mod stack") end

SaveState = {}

--Name of a handle, or an empty string if the handle is nil or invalid.
local function NameIfValid(obj)
	if obj and obj:isValid() then
		return obj.Name
	end
	return ""
end

--FSO 26.0 deprecated the old persistence enum names, which raise an error in a mod targeting 26.0 or later
local PERSIST_NONE = SEXPVAR_PERSIST_NONE or SEXPVAR_NOT_PERSISTENT

function SaveState:Init()

	ba.print("SAVELOAD: Initialization begun...!\n")

	self.WorksOutOfCampaign = true
	
	if self.WorksOutOfCampaign or mn.isInCampaign() then
		self.Enabled = true
	end
	
	if not self.Enabled then
		return
	end
	
	self.CurrentIndex = nil
	self.WingList = {}
	self.QueryStatusWarned = {}
	self.SupportShips = {}	--set of ship names identified as support ships while a live handle was available
	self.List = self:GetAllCurrentShips()


	self.CuedList = {}

	self.SaveFilename = self:SaveFilenameFor(mn.getMissionFilename())
	self.ExternalMission = nil
	self.ExternalData = nil

	self.LoadedData = {}
	if cf.fileExists(self.SaveFilename, "data/config") then
		local loaded = axemParse:ReadJSON(self.SaveFilename, "data/config")
		if type(loaded) == "table" then
			self.LoadedData = self:NormalizeSlots(loaded)
		else
			ba.print("SAVELOAD: Save file " .. self.SaveFilename .. " could not be parsed, starting with no save data\n")
		end
	end
	
	self.AssistList = {}
	self.AssistHP = nil
	self.AssistAmmo = nil
	
	self.ShipFlags = {"invulnerable", "protect-ship", "beam-protect-ship", "flak-protect-ship", "laser-protect-ship", "missile-protect-ship", "cargo-known", "hidden-from-sensors", "stealth", "friendly-stealth-invisible", "afterburners-locked", "primaries-locked", "secondaries-locked", "free-afterburner-use"}

end

function SaveState:AddWing(wingname)

	for i,v in ipairs(self.WingList) do
		if v == wingname then return end
	end
	
	ba.print("SAVELOAD: New wing found, " .. wingname ..",  adding to Wing List\n")
	self.WingList[#self.WingList+1] = wingname
	
	ba.print("SAVELOAD: Number of wings: " .. #self.WingList .."\n")

end

--This just gets called at mission start so we have the beginnings of our master list.
function SaveState:GetAllCurrentShips()

	ba.print("SAVELOAD: Getting ships present at start...\n")

	local t = {}
	
	for thisShip in mn.getShipList() do
		if thisShip and thisShip:isValid() then
			t[#t+1] = thisShip.Name
			ba.print("SAVELOAD: Found " .. thisShip.Name .. ", adding to Ship List\n")
			self:RecordSupportShip(thisShip)
			local wingname = NameIfValid(thisShip:getWing())
			if wingname ~= "" then
				self:AddWing(wingname)
			end
		end
	
	end
	
	ba.print("SAVELOAD: Found " .. #t .. " items.\n")
	
	return t

end

--When a ship arrives, we add it to THE LIST, which we'll check when we're saving. We want to catch every ship that arrives, even ones that might have died/left already, so that's why we're not just checking mn.Ships[].
function SaveState:AddShip(ship)

	ba.print("SAVELOAD: " .. ship.Name .. " arrived, adding to Ship List\n")

	if self.Enabled then
		self.List[#self.List+1] = ship.Name
		self:RecordSupportShip(ship)
		local wingname = NameIfValid(ship:getWing())
		if wingname ~= "" then
			self:AddWing(wingname)
		end
	end

	if self.CurrentIndex then
		self:CheckLateData(ship)
	end

end

--Called wherever we have a live ship handle, so the support-ship decision can be made from the ship type rather than the name.
function SaveState:RecordSupportShip(ship)

	if self:IsSupportShipHandle(ship) then
		ba.print("SAVELOAD: " .. ship.Name .. " is a support ship (by ship type), will be excluded from saves\n")
		self.SupportShips[ship.Name] = true
	end

end

function SaveState:CheckLateData(ship)

	ba.print("SAVELOAD: Checking " .. ship.Name .. " for late data\n")
	local thisShipName = ship.Name
	
	for i=1, #self.CuedList do
		if self.CuedList[i] and self.CuedList[i] == thisShipName then
			local thisloadeddata = self.LoadedData[self:SlotKey(self.CurrentIndex)]
			if type(thisloadeddata) ~= "table" then
				ba.print("SAVELOAD: save state " .. tostring(self.CurrentIndex) .. " no longer present, no late data for " .. thisShipName .. "\n")
				return
			end
			local data = thisloadeddata[thisShipName]

			if type(data) == "table" then self:ApplyLateData(ship,data) end

			return
		end
	end

end

 --Collecting data from a ship
function SaveState:GetShipData(shipname)

	ba.print("SAVELOAD: Getting ship data from " .. shipname .. "\n")

	local t = {}
	
	t.Name = shipname
	ba.print("Name: " .. tostring(t.Name) .. "\n")
		
	t.IsInMission = mn.evaluateSEXP("(is-in-mission !" .. t.Name .. "!)")
	ba.print("   Is In Mission: " .. tostring(t.IsInMission) .. "\n")
	t.HasArrived = mn.evaluateSEXP("(has-arrived-delay 0 !" .. t.Name .. "!)")
	ba.print("   Has Arrived: " .. tostring(t.HasArrived) .. "\n")
	t.HasBeenDestroyed = mn.evaluateSEXP("(is-destroyed-delay 0 !" .. t.Name .."!)")
	ba.print("   Has Been Destroyed: " .. tostring(t.HasBeenDestroyed) .. "\n")
	t.HasDeparted = mn.evaluateSEXP("(has-departed-delay 0 !" .. t.Name .."!)")
	ba.print("   Has Departed: " .. tostring(t.HasDeparted) .. "\n")
		
	if t.IsInMission then
	
		local ship = mn.Ships[shipname]
	
		if ship and ship:isValid() then
		
			--Get Class
			t.Class = ship.Class.Name
			ba.print("   Class: " .. tostring(t.Class) .. "\n")
			
			--Is this part of a wing?  Left absent if not, since a present Wing makes the load reset the wing's arrival.
			local wingname = NameIfValid(ship:getWing())
			if wingname ~= "" then
				t.Wing = wingname
				ba.print("   Wing: " .. tostring(t.Wing) .. "\n")
			end
			
			--Get HP, rounded up so a living ship is never saved as 0%
			t.HP = math.ceil((ship.HitpointsLeft / ship.HitpointsMax) * 100)
			ba.print("   HP: " .. tostring(t.HP) .. "\n")
		
			--Get Shields
			if ship.Shields and ship.Shields:isValid() and ship.Shields.CombinedMax > 0 then
				t.Shields = math.floor((ship.Shields.CombinedLeft / ship.Shields.CombinedMax) * 100)
				ba.print("   Shields: " .. tostring(t.Shields) .. "\n")
			end
			
			--Get Armor (LateData)
			t.HullArmor = ship.ArmorClass 
			ba.print("   Hull Armor: " .. tostring(t.HullArmor) .. "\n")
			t.ShieldArmor = ship.ShieldArmorClass
			ba.print("   Shield Armor: " .. tostring(t.ShieldArmor) .. "\n")
			
			--Get Team (LateData)
			t.Team = ship.Team.Name
			ba.print("   Team: " .. tostring(t.Team) .. "\n")
						
			--Get Countermeasures (LateData)
			t.Countermeasures = ship.CountermeasuresLeft
			ba.print("   Countermeasures: " .. tostring(t.Countermeasures) .. "\n")
			
			--Get Orders (LateData)
			ba.print("   Orders:\n")
			t.Orders = {}
			for i=1, #ship.Orders do
				local order = ship.Orders[i]
				ba.print("     Number: " .. i .. "\n")
				
				local tt = {}
				tt.Priority = order.Priority
				ba.print("     Priority: " .. tostring(tt.Priority) .. "\n")
				tt.Type = self:GetAIOrderFromEnum(order:getType())
				ba.print("     Type: " .. tostring(tt.Type) .. "\n")
				if (order:getType() == ORDER_WAYPOINTS) or (order:getType() == ORDER_WAYPOINTS_ONCE) then
					if order.WaypointList and order.WaypointList:isValid() then
						tt.WaypointList = order.WaypointList.Name
						tt.WaypointIndex = order.WaypointIndex
						tt.WaypointsInReverse = order.WaypointsInReverse
						ba.print("     Waypoint List: " .. tostring(tt.WaypointList) .. "\n")
						ba.print("     Waypoint Index: " .. tostring(tt.WaypointIndex) .. "\n")
						ba.print("     Reverse: " .. tostring(tt.WaypointsInReverse) .. "\n")
					end
				else
					if order.Target and order.Target:isValid() and order.Target:getBreedName() == "Ship" then
						tt.Target = order.Target.Name
						ba.print("     Target: " .. tostring(tt.Target) .. "\n")
					end
				end
				tt.Subsystem = NameIfValid(order.TargetSubsystem)
				ba.print("     Subsystem: " .. tostring(tt.Subsystem) .. "\n")
				
				t.Orders[i] = tt
				
			end
			
			--Get Flags (LateData)
			t.Flags = {}
			for i=1, #self.ShipFlags do
				if mn.evaluateSEXP("(are-ship-flags-set !" .. shipname .. "! !" .. self.ShipFlags[i] .. "!)") then
					t.Flags[i] = true
				else
					t.Flags[i] = false
				end
			end
			
			ba.print("   Flags:\n")
			for i=1, #self.ShipFlags do
				if t.Flags[i] then
					ba.print("       Index " .. i .. ": " .. tostring(self.ShipFlags[i]) .. "\n")		
				end
			end
			
			ba.print("   Subsystems:\n")
			
			--Subsystem craziness
			local numSubsys = #ship
			
			if numSubsys > 0 then
				t.Subsystems = {}
				
				for i=1, numSubsys do
				
					ba.print("      Subsystem " .. i .. "\n")
				
					local thisSubsys = ship[i]
					local ss = {}

					--Canonical name, so the entry can be matched by name on load rather than by position
					ss.Name = thisSubsys:getModelName()
					ba.print("        Subsystem Name: " .. tostring(ss.Name) .. "\n")

					if thisSubsys.HitpointsMax > 0 then
						--Rounded up, since a saved 0 means destroyed on load
						ss.HP = math.ceil((thisSubsys.HitpointsLeft / thisSubsys.HitpointsMax) * 100)
					else
						ss.HP = 0
					end
					ba.print("        HP: " .. tostring(ss.HP) .. "\n")
					ss.Armor = thisSubsys.ArmorClass
					ba.print("        Armor: " .. tostring(ss.Armor) .. "\n")
					
					if thisSubsys:isTurret() then
					
						ba.print("        Is a turret!\n")
					
						ss.TurretLocked = thisSubsys.TurretLocked -- (LateData)
						
						ba.print("        Locked: " .. tostring(ss.TurretLocked) .. "\n")
					
						if thisSubsys.PrimaryBanks and thisSubsys.PrimaryBanks:isValid() then
							ba.print("        Primary Banks:\n")
							ss.PBanks = {}
							for j=1, #thisSubsys.PrimaryBanks do
								if thisSubsys.PrimaryBanks[j] and thisSubsys.PrimaryBanks[j]:isValid() and thisSubsys.PrimaryBanks[j].AmmoMax > 0 then
									ba.print("          Bank: " .. j .. "\n")
									ss.PBanks[j] = {}
									ss.PBanks[j].Class = NameIfValid(thisSubsys.PrimaryBanks[j].WeaponClass)
									ba.print("          Class: " .. tostring(ss.PBanks[j].Class) .. "\n")
									ss.PBanks[j].AmmoLeft = math.floor((thisSubsys.PrimaryBanks[j].AmmoLeft / thisSubsys.PrimaryBanks[j].AmmoMax) * 100)
									ba.print("          AmmoLeft: " .. tostring(ss.PBanks[j].AmmoLeft) .. "\n")
								end
							end
						end
						
						if thisSubsys.SecondaryBanks and thisSubsys.SecondaryBanks:isValid() then
							ba.print("        Secondary Banks:\n")
							ss.SBanks = {}
							for j=1, #thisSubsys.SecondaryBanks do
								if thisSubsys.SecondaryBanks[j] and thisSubsys.SecondaryBanks[j]:isValid() and thisSubsys.SecondaryBanks[j].AmmoMax > 0 then
									ba.print("          Bank: " .. j .. "\n")
									ss.SBanks[j] = {}
									ss.SBanks[j].Class = NameIfValid(thisSubsys.SecondaryBanks[j].WeaponClass)
									ba.print("          Class: " .. tostring(ss.SBanks[j].Class) .. "\n")
									ss.SBanks[j].AmmoLeft = math.floor((thisSubsys.SecondaryBanks[j].AmmoLeft / thisSubsys.SecondaryBanks[j].AmmoMax) * 100)
									ba.print("          AmmoLeft: " .. tostring(ss.SBanks[j].AmmoLeft) .. "\n")
								end
							end
						end
					end
					
					t.Subsystems[i] = ss
					
				end
			end
				
			if ship.PrimaryBanks and ship.PrimaryBanks:isValid() then
			ba.print("   Ship Primary Banks:\n")
				t.PBanks = {}
				for i=1, #ship.PrimaryBanks do
					ba.print("     Bank: " .. i .. "\n")
					t.PBanks[i] = {}
					t.PBanks[i].Class = NameIfValid(ship.PrimaryBanks[i].WeaponClass)
					ba.print("     Class: " .. tostring(t.PBanks[i].Class) .. "\n")
					if ship.PrimaryBanks[i].AmmoMax > 0 then
						t.PBanks[i].AmmoLeft = math.floor((ship.PrimaryBanks[i].AmmoLeft / ship.PrimaryBanks[i].AmmoMax) * 100)
						ba.print("     AmmoLeft: " .. tostring(t.PBanks[i].AmmoLeft) .. "\n")
					end
				end
			end
			
			if ship.SecondaryBanks and ship.SecondaryBanks:isValid() then
			ba.print("   Ship Secondary Banks:\n")
				t.SBanks = {}
				for i=1, #ship.SecondaryBanks do
					ba.print("     Bank: " .. i .. "\n")
					t.SBanks[i] = {}
					t.SBanks[i].Class = NameIfValid(ship.SecondaryBanks[i].WeaponClass)
					ba.print("     Class: " .. tostring(t.SBanks[i].Class) .. "\n")
					if ship.SecondaryBanks[i].AmmoMax > 0 then
						t.SBanks[i].AmmoLeft = math.floor((ship.SecondaryBanks[i].AmmoLeft / ship.SecondaryBanks[i].AmmoMax) * 100)
						ba.print("     AmmoLeft: " .. tostring(t.SBanks[i].AmmoLeft) .. "\n")
					end
				end
			end
			
			if ship == hv.Player then
			
				t.AfterburnerFuelLeft = ship.AfterburnerFuelLeft 
				ba.print("   Afterburner: " .. tostring(t.AfterburnerFuelLeft) .. "\n")
				t.WeaponEnergyLeft = ship.WeaponEnergyLeft
				ba.print("   Afterburner: " .. tostring(t.WeaponEnergyLeft) .. "\n")
			
			end
			
			t.Position = {}
			t.Position.x = ship.Position.x
			t.Position.y = ship.Position.y
			t.Position.z = ship.Position.z
			ba.print("   Position: " .. tostring(ship.Position) .. "\n")
			
			t.Orientation = {}
			t.Orientation.p = ship.Orientation.p
			t.Orientation.b = ship.Orientation.b
			t.Orientation.h = ship.Orientation.h
			ba.print("   Orientation: " .. tostring(ship.Orientation) .. "\n")

			t.Velocity = {}
			t.Velocity.x = ship.Physics.Velocity.x
			t.Velocity.y = ship.Physics.Velocity.y
			t.Velocity.z = ship.Physics.Velocity.z
			ba.print("   Velocity: " .. tostring(ship.Physics.Velocity) .. "\n")
		
		end
		
	end

	return t, t.Name

end

function SaveState:GetWingData(wingname)

	ba.print("SAVELOAD: Getting wing data from " .. wingname .. "\n")

	local t = {}
	
	t.Name = wingname
		
	t.HasArrived = mn.evaluateSEXP("(has-arrived-delay 0 !" .. wingname .. "!)")
	t.HasBeenDestroyed = mn.evaluateSEXP("(is-destroyed-delay 0 !" .. wingname .."!)")
	t.HasDeparted = mn.evaluateSEXP("(has-departed-delay 0 !" .. wingname .."!)")
	
	return t, t.Name

end

function SaveState:CheckList(t, data)

	for i,v in ipairs(t) do
		if v == data then return true end
	end

	return false

end

-- ================================================== --
-- Validation helpers
-- ================================================== --

-- Returns a valid handle, or nil after logging. A failed lookup yields an invalid handle, or nil under the
-- nil-handles game setting. An empty name, which is how an empty weapon bank is saved, returns nil silently.
function SaveState:ResolveHandle(lookup, name, kind, shipname, where)

	if type(name) ~= "string" or name == "" then return nil end

	local handle = lookup[name]
	if handle and handle:isValid() then return handle end

	ba.print("SAVELOAD: " .. tostring(shipname) .. ": saved " .. kind .. " '" .. name .. "'"
		.. (where and (" for " .. tostring(where)) or "") .. " not found, keeping the current one\n")
	return nil

end

function SaveState:ResolveShipClass(name, shipname)

	return self:ResolveHandle(tb.ShipClasses, name, "ship class", shipname)

end

function SaveState:ResolveWeaponClass(name, shipname, where)

	return self:ResolveHandle(tb.WeaponClasses, name, "weapon class", shipname, where)

end

function SaveState:ResolveTeam(name, shipname)

	return self:ResolveHandle(mn.Teams, name, "team", shipname)

end

--Validity test for handles that may lack isValid() (parse_subsystem currently does). The fallback reads Name,
--which the API documents as empty on error.
function SaveState:HandleIsValid(h)

	if h == nil then return false end

	local ok, fn = pcall(function() return h.isValid end)
	if ok and type(fn) == "function" then
		local ok2, result = pcall(fn, h)
		return ok2 and result == true
	end

	local ok3, value = pcall(function() return h.Name end)
	return ok3 and value ~= nil and value ~= ""

end

--Save slots are keyed by string, since dkjson writes sparse numeric keys as strings.
function SaveState:SlotKey(index)

	if index == nil then return nil end

	return tostring(index)

end

--Converts every top-level key to a string so a legacy array-shaped file and a new object-shaped file look the same.
function SaveState:NormalizeSlots(t)

	local out = {}

	if type(t) ~= "table" then return out end

	for k, v in pairs(t) do
		out[tostring(k)] = v
	end

	return out

end

--Applies a saved bank array to a parse object's MainStatus, which holds weapon classes and ammo in parallel arrays
--rather than as bank handles, so it cannot share ApplyBankArray.
function SaveState:ApplyParseBankArray(banks, ammo, saved, shipname, label)

	if not banks then return end

	if type(saved) ~= "table" then saved = {} end

	ba.print("    Beginning " .. label .. " setup...\n       (in save data: " .. #saved .. ")\n       (on the parse object: " .. #banks .. ")\n")

	for i, bdata in ipairs(saved) do
		ba.print("         Bank " .. i .. ": ")
		if type(bdata) ~= "table" then
			ba.print("malformed bank entry, skipping\n")
		elseif not banks[i] then
			ba.print("no such bank on the parse object, skipping\n")
		else
			ba.print(tostring(bdata.Class) .. "\n")
			local wclass = self:ResolveWeaponClass(bdata.Class, shipname, label .. " " .. i)
			if wclass then
				banks[i] = wclass
			end
			if bdata.AmmoLeft and ammo then
				ammo[i] = self:GetAmmo(bdata.AmmoLeft, shipname)
				ba.print("           Ammo Left: " .. tostring(ammo[i]) .. "\n")
			end
		end
	end

end

--Sets or clears the ship flags recorded in the save. The saved list is positional against self.ShipFlags.
function SaveState:ApplyShipFlags(ship, data)

	if type(data.Flags) ~= "table" then return end

	for i=1, #self.ShipFlags do
		local value = data.Flags[i]
		if value ~= nil then
			local sexpstring = "(alter-ship-flag !" .. self.ShipFlags[i] .. "! (" .. tostring(value == true) .. ") (true) !" .. ship.Name .. "! )"
			ba.print(sexpstring .. "\n")
			mn.runSEXP(sexpstring)
		end
	end

end

--Applies a saved bank array to a live weaponbanktype, for the ship's own banks and for a turret's.
--warnOnCount is for callers whose saved array is dense; a sparse one (turret banks) would warn every time.
function SaveState:ApplyBankArray(banktype, saved, shipname, label, warnOnCount)

	if not banktype or not banktype:isValid() then return end

	if type(saved) ~= "table" then saved = {} end

	local n = #banktype
	ba.print("     " .. label .. "s: " .. n .. "\n")

	if warnOnCount and #saved ~= n then
		ba.print("SAVELOAD: " .. shipname .. ": saved " .. label .. " count " .. #saved .. " does not match current count " .. n .. ", applying what matches\n")
	end

	for i=1, n do
		if type(saved[i]) == "table" then
			self:ApplyBankData(banktype[i], saved[i], shipname, label .. " " .. i)
		end
	end

end

--Applies one saved weapon bank entry to a live weaponbank handle.
function SaveState:ApplyBankData(bank, bdata, shipname, where)

	if not bank or not bank:isValid() or type(bdata) ~= "table" then return end

	ba.print("        " .. tostring(where) .. ": " .. tostring(bdata.Class) .. "\n")

	local wclass = self:ResolveWeaponClass(bdata.Class, shipname, where)
	if wclass then
		bank.WeaponClass = wclass
	end

	if bdata.AmmoLeft ~= nil then
		bank.AmmoLeft = (self:GetAmmo(bdata.AmmoLeft, shipname) / 100) * bank.AmmoMax
		ba.print("          Ammo: " .. tostring(bank.AmmoLeft) .. "\n")
	end

end

--Applies saved subsystem data (hitpoints, armor, turret lock, turret banks) to a live ship, matched by canonical
--subsystem name. Saves without names fall back to position.
function SaveState:ApplySubsystemData(ship, data, shipname)

	local numSubsys = #ship
	if numSubsys <= 0 then return end

	local saved = data.Subsystems
	if type(saved) ~= "table" then saved = {} end

	local savedByName = {}
	local namedCount = 0
	for _, entry in ipairs(saved) do
		if type(entry) == "table" and type(entry.Name) == "string" then
			local key = entry.Name:lower()
			if savedByName[key] then
				ba.print("SAVELOAD: " .. shipname .. ": saved subsystem name '" .. entry.Name .. "' appears more than once, keeping the first\n")
			else
				savedByName[key] = entry
				namedCount = namedCount + 1
			end
		end
	end

	local legacy = (namedCount == 0 and #saved > 0)
	if legacy then
		ba.print("SAVELOAD: " .. shipname .. ": save has no subsystem names, matching by position\n")
	end

	if #saved ~= numSubsys then
		ba.print("SAVELOAD: " .. shipname .. ": saved subsystem count " .. #saved .. " does not match current count " .. numSubsys .. ", applying what matches\n")
	end

	local matched = {}

	for i=1, numSubsys do
		local thisSubsys = ship[i]

		if not thisSubsys or not thisSubsys:isValid() then
			ba.print("       Subsystem " .. i .. " - invalid handle, skipping\n")
		else
			local subsysName = thisSubsys:getModelName()
			local ssdata
			if legacy then
				ssdata = saved[i]
			else
				ssdata = savedByName[subsysName:lower()]
				if ssdata then matched[subsysName:lower()] = true end
			end

			if type(ssdata) ~= "table" then
				ba.print("       Subsystem " .. i .. " - " .. subsysName .. " - no saved data, skipping\n")
			else
				ba.print("       Subsystem " .. i .. " - " .. subsysName .. "\n")

				if ssdata.HP ~= nil and thisSubsys.HitpointsMax > 0 then
					if ssdata.HP <= 0 then
						--HitpointsLeft 0 only disables a subsystem, and -1 or lower blows it up with debris and effects
						ba.print("      Destroyed\n")
						mn.runSEXP("(destroy-subsys-instantly !" .. ship.Name .. "! !" .. subsysName .. "!)")
					else
						ba.print("      HP Left: " .. tostring((ssdata.HP / 100) * thisSubsys.HitpointsMax) .. "\n")
						thisSubsys.HitpointsLeft = (ssdata.HP / 100) * thisSubsys.HitpointsMax
					end
				end

				if ssdata.Armor then
					ba.print("      Armor Class: " .. tostring(ssdata.Armor) .. "\n")
					thisSubsys.ArmorClass = ssdata.Armor
				end

				if thisSubsys:isTurret() then

					ba.print("      This is a turret!\n")

					if ssdata.TurretLocked ~= nil then
						ba.print("        Locked: " .. tostring(ssdata.TurretLocked) .. "\n")
						thisSubsys.TurretLocked = ssdata.TurretLocked
					end

					--No count warning: turret banks are saved only if they carry ammo, so the array is sparse
					self:ApplyBankArray(thisSubsys.PrimaryBanks, ssdata.PBanks, shipname, subsysName .. " primary bank")
					self:ApplyBankArray(thisSubsys.SecondaryBanks, ssdata.SBanks, shipname, subsysName .. " secondary bank")
				end
			end
		end
	end

	if not legacy then
		for key, entry in pairs(savedByName) do
			if not matched[key] then
				ba.print("SAVELOAD: " .. shipname .. ": saved subsystem '" .. entry.Name .. "' is not on the ship, skipping\n")
			end
		end
	end

end

--Applies the ship's own primary and secondary bank data, which is saved densely.
function SaveState:ApplyShipBankData(ship, data, shipname)

	self:ApplyBankArray(ship.PrimaryBanks, data.PBanks, shipname, "primary bank", true)
	self:ApplyBankArray(ship.SecondaryBanks, data.SBanks, shipname, "secondary bank", true)

end

function SaveState:GetVariableData(exclusionList)

	ba.print("SAVELOAD: Getting mission variables...\n")

	local t = {}

	for i = 1, #mn.SEXPVariables do
		local var = mn.SEXPVariables[i]
		if var and var:isValid() then
			if var.Persistence == PERSIST_NONE and not self:CheckList(exclusionList, var.Name) then
				local typeStr
				if var.Type == SEXPVAR_TYPE_NUMBER then typeStr = "number"
				elseif var.Type == SEXPVAR_TYPE_STRING then typeStr = "string" end
				if typeStr then
					t[var.Name] = { Type = typeStr, Value = var.Value }
					ba.print("SAVELOAD: Saved variable " .. var.Name .. " (" .. typeStr .. ") = " .. tostring(var.Value) .. "\n")
				end
			end
		end
	end

	return t

end

function SaveState:ApplyVariableData(varTable)

	if not varTable then return end

	ba.print("SAVELOAD: Applying mission variables...\n")

	for name, entry in pairs(varTable) do
		local var = mn.SEXPVariables[name]
		if var and var:isValid() then
			local currentType
			if var.Type == SEXPVAR_TYPE_NUMBER then currentType = "number"
			elseif var.Type == SEXPVAR_TYPE_STRING then currentType = "string" end
			if currentType ~= entry.Type then
				ba.print("SAVELOAD: Variable " .. name .. " type mismatch (saved " .. tostring(entry.Type) .. ", current " .. tostring(currentType) .. "), skipping\n")
			else
				var.Value = entry.Value
				ba.print("SAVELOAD: Restored variable " .. name .. " = " .. tostring(entry.Value) .. "\n")
			end
		else
			ba.print("SAVELOAD: Variable " .. name .. " no longer exists, skipping\n")
		end
	end

end

 --This is what lua-savestate-save calls
 --We go through THE LIST and nab all of the ship data which will go into self.LoadedData which is what will get saved.
 --We use the ship name as a key for the data table for ease of retrival and checking later. This might take a bit more CPU time, but we can probably spare it.
function SaveState:SaveAll(index, ...)

	ba.print("SAVELOAD: ***** BEGINNING SAVE STATE! *****\n")

	if not self.Enabled then return false end

	local data = {}
	
	local exclusionList = {}
	
	for i, v in ipairs(arg) do
		ba.print("SAVELOAD: Adding " .. v[1] .. " to exclusion list\n")
		exclusionList[#exclusionList+1] = v[1]
	end
		
	for i, entry in ipairs(self.List) do
		if self:CheckList(exclusionList,entry) then
			ba.print("SAVELOAD: Skipping " .. entry .. " (on exclusion list)\n")
		else
			local isSupport, route = self:IsSupportShip(entry)
			if isSupport then
				ba.print("SAVELOAD: Skipping " .. entry .. " (support ship, detected by " .. tostring(route) .. ")\n")
			else
				local shipdata, key = self:GetShipData(entry)
				data[key] = shipdata
			end
		end
	end
	
	data.Wings = {}

	for i, entry in ipairs(self.WingList) do
		if not self:CheckList(exclusionList,entry) then
			local wingdata, key = self:GetWingData(entry)
			data.Wings[key] = wingdata
		end
	end

	data.Variables = self:GetVariableData(exclusionList)

	local slot
	if index ~= nil then
		slot = self:SlotKey(index)
	else
		--lua-savestate-save requires an index, so this is only a fallback: next free numeric slot
		local highest = 0
		for k in pairs(self.LoadedData) do
			local n = tonumber(k)
			if n and n > highest then highest = n end
		end
		slot = self:SlotKey(highest + 1)
	end
	self.LoadedData[slot] = data

	ba.print("SAVELOAD: Writing save data to file " .. self.SaveFilename .. " with save index " .. tostring(slot) .. "\n")
	axemParse:WriteJSON(self.LoadedData, self.SaveFilename, "data/config")

end

 --This is what lua-savestate-load calls
 --Determinations are used to figure out how to apply the data. If the ship is present, we can apply it now. If not, we'll need to put it in the parsed object data. We also check if the ship is blown up or departed, where we can instantly and forcefully apply these things.
function SaveState:LoadAll(index)

	if not self.Enabled then return false end
	
	ba.print("SAVELOAD: ***** BEGINNING LOAD STATE! *****\n")

	if not index then
		ba.print("SAVE STATE: no index specified, aborting load data.\n")
		return
	end

	local thisloadeddata = self.LoadedData[self:SlotKey(index)]

	if type(thisloadeddata) ~= "table" then
		ba.print("SAVE STATE: index " .. tostring(index) .. " not found, aborting load data.\n")
		return
	end

	--Only commit to the index once we know the slot exists, otherwise CheckLateData would index nil on every arrival
	self.CurrentIndex = index

	--Restore mission variables before touching ships, so any SEXP evaluation
	--triggered by ship-apply code sees the correct variable values.
	self:ApplyVariableData(thisloadeddata.Variables)

	--Apply saved data to ships that are present
	
	for thisShip in mn.getShipList() do
		if thisShip and thisShip:isValid() then
			local thisShipName = thisShip.Name
			local data = thisloadeddata[thisShipName]

			if type(data) == "table" then
				if data.IsInMission then --Present from the start and was alive during save...
					self:ApplyData(thisShip,data)
				else
					if data.HasBeenDestroyed then -- or was destroyed
						self:InstantKill(thisShip)
					elseif data.HasDeparted then -- or had left
						self:InstantDepart(thisShip)
					end
				end
			end
		end
	end
	
	--Apply saved data to ships that have yet to arrive
	
	for thisShip in mn.getArrivalList() do

		local data = thisloadeddata[thisShip.Name]

		if type(data) == "table" then
			if data.IsInMission then
				self:ApplyParseData(thisShip,data)
				self.CuedList[#self.CuedList+1] = thisShip.Name
			elseif data.HasBeenDestroyed or data.HasDeparted then
				--Nothing to restore, but the ship still has to be killed or sent away when it arrives
				self.CuedList[#self.CuedList+1] = thisShip.Name
			else
				--Had not arrived when saved, so there is nothing to apply and its FRED arrival state must be kept
				ba.print("SAVELOAD: " .. thisShip.Name .. " had not arrived when the save was made, leaving it alone\n")
			end
		end

	end

end

function SaveState:GiveOrders(ship,data)

	mn.runSEXP("(clear-goals !" .. ship.Name .. "!)")

	if type(data.Orders) ~= "table" then return end

	for i=1, #data.Orders do
		ba.print("     Order " .. i .. ":")

		local thisOrder = data.Orders[i]
		if type(thisOrder) ~= "table" then
			ba.print(" malformed order entry, skipping\n")
		else
			self:GiveOneOrder(ship, thisOrder)
		end

	end

end

function SaveState:GiveOneOrder(ship, thisOrder)

	local order = self:GetAIOrderFromString(thisOrder.Type)
	local priority = (thisOrder.Priority or 0) / 100	-- because ship:giveOrder uses [0.0, 1.0] rather than [0, 100]

	if order == ORDER_WAYPOINTS or order == ORDER_WAYPOINTS_ONCE then
		local wpl = thisOrder.WaypointList and mn.WaypointLists[thisOrder.WaypointList]
		if wpl and wpl:isValid() then
			local wp = wpl[thisOrder.WaypointIndex]
			if wp and wp:isValid() then
				ba.print(tostring(order) .. " Waypoint List: " .. tostring(thisOrder.WaypointList) .. " Index: " .. tostring(thisOrder.WaypointIndex) .. "\n")
				ship:giveOrder(order, wp, nil, priority)
				if thisOrder.WaypointsInReverse then
					local newOrder = ship.Orders[#ship.Orders]
					if newOrder and newOrder:isValid() then
						newOrder.WaypointsInReverse = true
					end
				end
			end
		end
	else
		local targetShip
		if thisOrder.Target then
			targetShip = mn.Ships[thisOrder.Target]
		end
		local targetSubsystem = thisOrder.Subsystem

		ba.print(tostring(order) .. " Target: " .. tostring(targetShip) .. " Target Subsystem: " .. tostring(targetSubsystem) .. "\n")

		if order and targetShip and targetShip:isValid() then
			if targetSubsystem then
				ship:giveOrder(order, targetShip, targetShip[targetSubsystem], priority)
			else
				ship:giveOrder(order, targetShip, nil, priority)
			end
		end
	end

end

--Applying data to ships already present at time of load
function SaveState:ApplyData(ship,data,external)

	ba.print("SAVELOAD: Applying data to " .. ship.Name .. "\n")

	local shipname = data.Name or ship.Name

	--Class lookup is case-insensitive, so compare with the resolved handle's own name
	if data.Class then
		local newClass = self:ResolveShipClass(data.Class, shipname)
		if newClass and ship.Class.Name ~= newClass.Name then
			ba.print("    Applying Class: " .. tostring(newClass.Name) .. "\n")
			ship.Class = newClass
		end
	end

	ship.HitpointsLeft = (self:GetHP(data.HP,shipname) / 100) * ship.HitpointsMax
	ba.print("    Applying HP Left: " .. tostring(ship.HitpointsLeft) .. "\n")
	
	ba.print("    Applying Shields: ")
	if data.Shields and ship.Shields and ship.Shields:isValid() then
		for i=1, #ship.Shields do
			ship.Shields[i] = (data.Shields / 100 / #ship.Shields) * ship.Shields.CombinedMax
			ba.print("Quad" .. i .. ": " .. tostring(ship.Shields[i]))
		end
	end
	
	ba.print("\n")
	
	if data.HullArmor ~= nil then
		ba.print("    Applying Armor Class: " .. tostring(data.HullArmor) .. "\n")
		ship.ArmorClass = data.HullArmor
	end
	if data.ShieldArmor ~= nil then
		ba.print("    Applying Shield Armor Class: " .. tostring(data.ShieldArmor) .. "\n")
		ship.ShieldArmorClass = data.ShieldArmor
	end

	ba.print("    Applying Team: " .. tostring(data.Team) .. "\n")
	local team = self:ResolveTeam(data.Team, shipname)
	if team then
		ship.Team = team
	end

	if not external then
		ba.print("     Applying Orders:\n")
		self:GiveOrders(ship, data)
	end

	ba.print("     Applying Ship Flags...\n")
	self:ApplyShipFlags(ship, data)

	if data.Countermeasures ~= nil then
		ba.print("    Applying Countermeasures: " .. tostring(data.Countermeasures) .. "\n")
		ship.CountermeasuresLeft = data.Countermeasures
	end

	ba.print("    Applying Subsystem data...\n")
	self:ApplySubsystemData(ship, data, shipname)

	ba.print("    Applying Weapon Bank data...\n")
	self:ApplyShipBankData(ship, data, shipname)

	if ship == hv.Player then

		if data.AfterburnerFuelLeft ~= nil then
			ba.print("    Applying Afterburner Fuel: " .. tostring(data.AfterburnerFuelLeft) .. "\n")
			ship.AfterburnerFuelLeft = data.AfterburnerFuelLeft
		end
		if data.WeaponEnergyLeft ~= nil then
			ba.print("    Applying Weapon Energy: " .. tostring(data.WeaponEnergyLeft) .. "\n")
			ship.WeaponEnergyLeft = data.WeaponEnergyLeft
		end

	end

	if not external then
		if type(data.Position) == "table" then
			local newPosition = ba.createVector(data.Position.x, data.Position.y, data.Position.z)
			ba.print("    Applying Position: " .. tostring(newPosition) .. "\n")
			ship.Position = newPosition
		end

		if type(data.Orientation) == "table" then
			local newOrientation = ba.createOrientation(data.Orientation.p, data.Orientation.b, data.Orientation.h)
			ba.print("    Applying Orientation: " .. tostring(newOrientation) .. "\n")
			ship.Orientation = newOrientation
		end

		if type(data.Velocity) == "table" then
			local newVelocity = ba.createVector(data.Velocity.x, data.Velocity.y, data.Velocity.z)
			ba.print("    Applying Velocity: " .. tostring(newVelocity) .. "\n")
			ship.Physics.Velocity = newVelocity
		end
	end

end

--Bang
function SaveState:InstantKill(ship)

	mn.runSEXP("(destroy-instantly !" .. ship.Name .. "! )")
	
end

--Bon voyage!
function SaveState:InstantDepart(ship)

	mn.runSEXP("(set-departure-info !" .. ship.Name .. "! !Hyperspace! !<no anchor>! 0 0 (false))")
	ship:warpOut()

end

--Applying data to parse objects, or the objects that have yet to actually arrive in game yet.
function SaveState:ApplyParseData(ship,data)

	ba.print("SAVELOAD: Applying parse data to " .. ship.Name .. "\n")

	local shipname = data.Name or ship.Name

	--Set the ship to arrive by hyperspace without warp-in to save the FREDder from having to do that
	mn.runSEXP("(set-arrival-info !" .. ship.Name .. "! !Hyperspace! !<any friendly>! 0 0 0 (false))")
	ba.print("    set-arrival-info set!\n")

	if data.Wing then
		mn.runSEXP("(set-arrival-info !" .. data.Wing .. "! !Hyperspace! !<any friendly>! 0 0 0 (false))")
		ba.print("    set-arrival-info (wing) set!\n")
	end

	if data.Class then
		local newClass = self:ResolveShipClass(data.Class, shipname)
		if newClass and ship.ShipClass.Name ~= newClass.Name then
			ship.ShipClass = newClass
			ba.print("    Ship Class set: " .. tostring(ship.ShipClass.Name) .. "\n")
		end
	end

	ship.InitialHull = self:GetHP(data.HP,shipname)
	ba.print("    Initial Hull set: " .. tostring(ship.InitialHull) .. "\n")

	if data.Shields then
		ship.InitialShields = data.Shields
		ba.print("    Initial Shields set: " .. tostring(ship.InitialShields) .. "\n")
	end

	local mainStatus = ship.MainStatus

	if not self:HandleIsValid(mainStatus) then
		ba.print("    MainStatus handle not valid (no loadout change in FRED); weapon banks will be applied on arrival\n")
	else
		self:ApplyParseBankArray(mainStatus.PrimaryBanks, mainStatus.PrimaryAmmo, data.PBanks, shipname, "primary bank")
		self:ApplyParseBankArray(mainStatus.SecondaryBanks, mainStatus.SecondaryAmmo, data.SBanks, shipname, "secondary bank")
	end

	--Subsystem data is applied on arrival instead: the parse object lists only the subsystems FRED wrote, in file order
	ba.print("    Done with weapons... subsystem data will be applied on arrival\n")

	if type(data.Position) == "table" then
		local newPosition = ba.createVector(data.Position.x, data.Position.y, data.Position.z)
		ship.Position = newPosition
		ba.print("    Position: " .. tostring(newPosition) .. "\n")
	end

	if type(data.Orientation) == "table" then
		local newOrientation = ba.createOrientation(data.Orientation.p, data.Orientation.b, data.Orientation.h)
		ship.Orientation = newOrientation
		ba.print("    Orientation: " .. tostring(newOrientation) .. "\n")
	end

end

--Apply data to ships that aren't present at time of load and don't have the right parse data parameters
function SaveState:ApplyLateData(ship,data)

	ba.print("SAVELOAD: Applying late data to " .. ship.Name .. "\n")

	local shipname = data.Name or ship.Name

	if data.HasBeenDestroyed then
		ba.print("   Killing ship...\n")
		self:InstantKill(ship)
		return
	elseif data.HasDeparted then
		ba.print("   Instantly departing ship...\n")
		self:InstantDepart(ship)
		return
	elseif not data.IsInMission then
		--Only status flags are saved for a ship not in the mission, so there is nothing to apply
		ba.print("   Ship was not in the mission when the save was made, nothing to apply\n")
		return
	end

	--Apply Armor
	if data.HullArmor ~= nil then
		ba.print("   Applying armor: " .. tostring(data.HullArmor) .."\n")
		ship.ArmorClass = data.HullArmor
	end
	if data.ShieldArmor ~= nil then
		ba.print("   Applying shield armor: " .. tostring(data.ShieldArmor) .."\n")
		ship.ShieldArmorClass = data.ShieldArmor
	end

	--Apply Team
	ba.print("   Applying team: " .. tostring(data.Team) .."\n")
	local team = self:ResolveTeam(data.Team, shipname)
	if team then
		ship.Team = team
	end

	--Apply Countermeasures
	if data.Countermeasures ~= nil then
		ba.print("   Applying countermeasure count: " .. tostring(data.Countermeasures) .."\n")
		ship.CountermeasuresLeft = data.Countermeasures
	end

	--Apply AI Orders
	ba.print("   Applying AI orders\n")
	self:GiveOrders(ship, data)
	
	--Apply Ship Flags
	ba.print("   Running SEXPs for ship flags...\n")
	self:ApplyShipFlags(ship, data)

	ba.print("   Applying subsystem data...\n")
	self:ApplySubsystemData(ship, data, shipname)

	--Also covers ships whose parse object had no MainStatus
	ba.print("   Applying weapon bank data...\n")
	self:ApplyShipBankData(ship, data, shipname)

end

--Why...
function SaveState:GetAIOrderFromEnum(orderEnum)

	local order
	
	if orderEnum == ORDER_ATTACK then
		order = "Attack"
	elseif orderEnum == ORDER_ATTACK_ANY then
		order = "Attack Any"
	elseif orderEnum == ORDER_DEPART then
		order = "Depart"
	elseif orderEnum == ORDER_DISABLE then
		order = "Disable"
	elseif orderEnum == ORDER_DISARM then
		order = "Disarm"
	elseif orderEnum == ORDER_DOCK then
		order = "Dock"
	elseif orderEnum == ORDER_EVADE then
		order = "Evade"
	elseif orderEnum == ORDER_FLY_TO then
		order = "Fly to"
	elseif orderEnum == ORDER_FORM_ON_WING then
		order = "Form on Wing"
	elseif orderEnum == ORDER_GUARD then
		order = "Guard"
	elseif orderEnum == ORDER_IGNORE_SHIP then
		order = "Ignore"
	elseif orderEnum == ORDER_KEEP_SAFE_DISTANCE then
		order = "Keep Safe Distance"
	elseif orderEnum == ORDER_PLAY_DEAD then
		order = "Play Dead"
	elseif orderEnum == ORDER_REARM then
		order = "Rearm"
	elseif orderEnum == ORDER_STAY_NEAR then
		order = "Stay Near"
	elseif orderEnum == ORDER_STAY_STILL then
		order = "Stay Still"
	elseif orderEnum == ORDER_UNDOCK then
		order = "Undock"
	elseif orderEnum == ORDER_WAYPOINTS then
		order = "Waypoints"
	elseif orderEnum == ORDER_WAYPOINTS_ONCE then
		order = "Waypoints Once"
	elseif orderEnum == ORDER_ATTACK_WING then
		order = "Attack Wing"
	elseif orderEnum == ORDER_GUARD_WING then
		order = "Guard Wing"
	else
		order = "None"
	end
		
	return order

end

--Why????
function SaveState:GetAIOrderFromString(order)

	local orderEnum
	
	if order == "Attack" then
		orderEnum = ORDER_ATTACK
	elseif order == "Attack Any" then
		orderEnum = ORDER_ATTACK_ANY
	elseif order == "Depart" then
		orderEnum = ORDER_DEPART
	elseif order == "Disable" then
		orderEnum = ORDER_DISABLE
	elseif order == "Disarm" then
		orderEnum = ORDER_DISARM
	elseif order == "Dock" then
		orderEnum = ORDER_DOCK
	elseif order == "Evade" then
		orderEnum = ORDER_EVADE
	elseif order == "Fly to" then
		orderEnum = ORDER_FLY_TO
	elseif order == "Form on Wing" then
		orderEnum = ORDER_FORM_ON_WING
	elseif order == "Guard" then
		orderEnum = ORDER_GUARD
	elseif order == "Ignore" then
		orderEnum = ORDER_IGNORE_SHIP
	elseif order == "Keep Safe Distance" then
		orderEnum = ORDER_KEEP_SAFE_DISTANCE
	elseif order == "Play Dead" then
		orderEnum = ORDER_PLAY_DEAD
	elseif order == "Rearm" then
		orderEnum = nil
		--orderEnum = ORDER_REARM
	elseif order == "Stay Near" then
		orderEnum = ORDER_STAY_NEAR
	elseif order == "Stay Still" then
		orderEnum = ORDER_STAY_STILL
	elseif order == "Undock" then
		orderEnum = ORDER_UNDOCK
	elseif order == "Waypoints" then
		orderEnum = ORDER_WAYPOINTS
	elseif order == "Waypoints Once" then
		orderEnum = ORDER_WAYPOINTS_ONCE
	elseif order == "Attack Wing" then
		orderEnum = ORDER_ATTACK_WING
	elseif order == "Guard Wing" then
		orderEnum = ORDER_GUARD_WING
	else
		orderEnum = nil
	end
	
	return orderEnum

end

--Solves world hunger
function SaveState:GetCurrentSaveIndex()

	return self.CurrentIndex or 0

end

 --Returns false if a ship is destroyed or departed in the current save slot or another specified one.
function SaveState:QueryStatus(object, index)

	if not self.Enabled then return false end

	if (not index) and (not self.CurrentIndex) then
		return true
	end

	local slotkey = self:SlotKey(index or self.CurrentIndex)
	local slot = self.LoadedData[slotkey]

	if type(slot) ~= "table" then
		--No such save state; behave as if nothing had been loaded so arrivals are not blocked.
		--This sits in arrival cues, which are evaluated every frame, so warn once per slot rather than per call.
		self.QueryStatusWarned = self.QueryStatusWarned or {}
		if not self.QueryStatusWarned[tostring(slotkey)] then
			self.QueryStatusWarned[tostring(slotkey)] = true
			ba.print("SAVELOAD: QueryStatus: save state " .. tostring(slotkey) .. " not found, treating its ships as present\n")
		end
		return true
	end

	local saveData

	--Wait is this actually a wing?

	if mn.Wings[object] and mn.Wings[object]:isValid() then
		saveData = slot.Wings
	else
		saveData = slot
	end

	if type(saveData) == "table" and type(saveData[object]) == "table" then
		if saveData[object].HasBeenDestroyed then
			return false
		elseif saveData[object].HasDeparted then
			return false
		else
			return true
		end
	end

	--Not in the save state, so it had not arrived when the checkpoint was taken
	return true

end

function SaveState:ExternalLoad(index, mission, ...)

	ba.print("SAVELOAD: Beginning External Load!\n")

	local data = self:GetMissionData(mission)
	local key = self:SlotKey(index)

	if data and key and type(data[key]) == "table" then

		local saveData = data[key]
	
		for i, v in ipairs(arg) do
			local shipname = v[1]

			ba.print("SAVELOAD: Attempting to load data for " .. tostring(shipname) .. "\n")

			local entry = saveData[shipname]
			local thisShip = mn.Ships[shipname]

			--The slot also holds the Wings and Variables tables, so check both the entry and the ship
			if type(entry) ~= "table" or not entry.IsInMission then
				ba.print("SAVELOAD: no usable saved data for " .. tostring(shipname) .. " in the external save, skipping\n")
			elseif not (thisShip and thisShip:isValid()) then
				ba.print("SAVELOAD: " .. tostring(shipname) .. " is not present in this mission, skipping\n")
			else
				self:ApplyData(thisShip,entry,true)
			end
		end
	end
	
	ba.print("SAVELOAD: Finished External Load!\n")

end

function SaveState:ExternalLoadVar(index, mission, ...)

	ba.print("SAVELOAD: Beginning External Variable Load!\n")

	local data = self:GetMissionData(mission)
	local key = self:SlotKey(index)

	if data and key and type(data[key]) == "table" and type(data[key].Variables) == "table" then

		local saveData = data[key].Variables
		local requested = {}

		for i, v in ipairs(arg) do
			local varname = v[1].Name
			ba.print("SAVELOAD: Requesting external variable " .. varname .. "\n")
			if saveData[varname] then
				requested[varname] = saveData[varname]
			else
				ba.print("SAVELOAD: Variable " .. varname .. " not found in external save, skipping\n")
			end
		end

		self:ApplyVariableData(requested)
	end

	ba.print("SAVELOAD: Finished External Variable Load!\n")

end

 --Takes the mission name as the FREDder wrote it, with or without the extension and in any case.
 --The cache key is the folded form, so callers compare with NormalizeMissionName.
function SaveState:LoadExternalData(mission)

	ba.print("SAVELOAD: Loading external data, " .. mission .. "\n")

	local tempmissionfilename = self:FindSaveFile(self:SaveFilenameFor(mission))

	self.ExternalMission = self:NormalizeMissionName(mission)

	local loaded = axemParse:ReadJSON(tempmissionfilename, "data/config")
	if type(loaded) ~= "table" then
		ba.print("SAVELOAD: External save file " .. tempmissionfilename .. " could not be parsed, treating as empty\n")
		loaded = {}
	end
	self.ExternalData = self:NormalizeSlots(loaded)

end

 --Save data for a mission named in a SEXP, served from memory for the current mission
function SaveState:GetMissionData(mission)

	if self:NormalizeMissionName(mission) == self:NormalizeMissionName(mn.getMissionFilename()) then
		return self.LoadedData
	end

	if self:NormalizeMissionName(mission) ~= self.ExternalMission then self:LoadExternalData(mission) end
	return self.ExternalData

end

 --Checks to see if a save slot exists or not. We can also look at other mission save states.
function SaveState:Exists(index, mission)

	if not self.Enabled then return false end
	
	local data
		
	if not mission then
		data = self.LoadedData
	else
		data = self:GetMissionData(mission)
	end
	
	if type(data) == "table" then
		if not index then
			if next(data) ~= nil then
				return true
			end
		else
			if type(data[self:SlotKey(index)]) == "table" then
				return true
			end
		end
	end
	
	return false

end

 --Anti-frustration measure so someone might not be stuck at 2% hull on checkpoint load
function SaveState:AssistAdd(minhull, minammo, ...)

	self.AssistHP = minhull or 0
	self.AssistAmmo = minammo or 0
	
	for i,v in ipairs(arg) do
	
		self.AssistList[v[1]] = true
	
	end

end

 --These special functions might intervene if the ship is on the AssistList by increasing starting HP/Ammo
function SaveState:GetHP(hp,ship)

	if self.AssistHP and self.AssistList[ship] and hp then
		if hp < self.AssistHP then
			return self.AssistHP
		end
	end
	
	return hp or 100

end

function SaveState:GetAmmo(ammo,ship)

	if self.AssistAmmo and self.AssistList[ship] and ammo then
		if ammo < self.AssistAmmo then
			return self.AssistAmmo
		end
	end
	
	return ammo or 0

end

 --Clears save data
function SaveState:Clear(index)

	if not index then
		self.LoadedData = {}
		cf.deleteFile(self.SaveFilename, "data/config")
	else
		self.LoadedData[self:SlotKey(index)] = nil
		axemParse:WriteJSON(self.LoadedData, self.SaveFilename, "data/config")
	end

end

 --I TOLD them no .fs2 extension, but there's a chance they won't listen!
function SaveState:StripFS2(s)

	if type(s) ~= "string" then return s end

	local pos = s:lower():find(".fs2", -4, true)

	if pos then
		return s:sub(1, pos-1)
	end

	return s

end

 --Builds a save filename, preserving the mission name's case since not every filesystem is case-insensitive.
function SaveState:SaveFilenameFor(missionname)

	return ba.getCurrentPlayer():getName() .. "_" .. self:StripFS2(missionname) .. ".sav"

end

 --Returns the on-disk name of a save file, matched case-insensitively, or the given name if there is none.
 --The engine's case-insensitive file index never includes .sav files, so this lists the directory.
function SaveState:FindSaveFile(filename)

	local files = cf.listFiles("data/config", "*.sav") or {}

	for _, name in ipairs(files) do
		if name == filename then return name end
	end

	local wanted = filename:lower()
	for _, name in ipairs(files) do
		if name:lower() == wanted then
			ba.print("SAVELOAD: Using save file " .. name .. " for " .. filename .. "\n")
			return name
		end
	end

	return filename

end

 --Canonical form for COMPARING mission names. Never use this to build a filename.
function SaveState:NormalizeMissionName(mission)

	if type(mission) ~= "string" then return mission end

	return self:StripFS2(mission):lower()

end

 --The engine's ship type (objecttypes.tbl) is the authoritative signal, and there is no class flag for it.
function SaveState:IsSupportShipClass(class)

	if not class or not class:isValid() then return false end

	return NameIfValid(class.Type):lower() == "support"

end

 --The decision is made while a live handle is available, because by save time the ship may already be gone;
 --see IsSupportShip for the fallbacks. A ship handle and a parse object spell the class field differently.
function SaveState:IsSupportShipHandle(ship)

	if not ship or not ship:isValid() then return false end

	return self:IsSupportShipClass(ship.Class)

end

function SaveState:IsSupportShipParseObject(parsed)

	if not parsed or not parsed:isValid() then return false end

	return self:IsSupportShipClass(parsed.ShipClass)

end

 --Returns true and the detection route ("type", "registry" or "prefix") when the named ship is a support ship.
function SaveState:IsSupportShip(entry)

	--Recorded from a live handle when the ship was added to the list
	if self.SupportShips and self.SupportShips[entry] then
		return true, "type"
	end

	--Try to resolve a handle now; covers ships added before SupportShips existed or a stale list entry
	local regEntry = mn.ShipRegistry[entry]
	if regEntry and regEntry:isValid() then
		local ship = regEntry:getShip()
		if ship and ship:isValid() then
			if self:IsSupportShipHandle(ship) then return true, "registry" end
			return false
		end
		local parsed = regEntry:getParsedShip()
		if parsed and parsed:isValid() then
			if self:IsSupportShipParseObject(parsed) then return true, "registry" end
			return false
		end
	end

	--Nothing resolvable (e.g. a ship-create'd support ship that has already died). Fall back to the engine naming convention.
	if entry:sub(1, #"Support") == "Support" then
		return true, "prefix"
	end

	return false

end

--Lua SEXP definitions
mn.LuaSEXPs["lua-savestate-save"].Action = function(index, ...) SaveState:SaveAll(index, ...) end
mn.LuaSEXPs["lua-savestate-load"].Action = function(index) SaveState:LoadAll(index) end
mn.LuaSEXPs["lua-savestate-load-external"].Action = function(index, mission, ...) return SaveState:ExternalLoad(index, mission, ...) end
mn.LuaSEXPs["lua-savestate-load-external-var"].Action = function(index, mission, ...) SaveState:ExternalLoadVar(index, mission, ...) end
mn.LuaSEXPs["lua-savestate-shipstatus"].Action = function(name, index) return SaveState:QueryStatus(name, index) end
mn.LuaSEXPs["lua-savestate-getindex"].Action = function() return SaveState:GetCurrentSaveIndex() end
mn.LuaSEXPs["lua-savestate-check"].Action = function(index, mission) return SaveState:Exists(index, mission) end
mn.LuaSEXPs["lua-savestate-assist"].Action = function(minhull, minammo, ...) return SaveState:AssistAdd(minhull, minammo, ...) end
mn.LuaSEXPs["lua-savestate-clear"].Action = function(index) SaveState:Clear(index) end

]

$State: GS_STATE_GAME_PLAY
$On Gameplay Start:
[
	SaveState:Init()
]

$On Ship Arrive:
[
	SaveState:AddShip(hv.Ship)
]

$On Frame:
[
	--PrintDebug(SaveState.List)
	--PrintDebug(SaveState.LoadedData)
]

#End